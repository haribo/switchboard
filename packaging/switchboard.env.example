# switchboard settings. Edit, then: systemctl --user restart switchboard
# This file is never overwritten by an install or an upgrade.

# Where the service listens. The PO's page is served here.
SWITCHBOARD_ADDR=127.0.0.1:8787


# Grouping of the manager's wake-up signal.
SWITCHBOARD_DEBOUNCE=3m
SWITCHBOARD_MIN_INTERVAL=5m
SWITCHBOARD_URGENT=30s

# How long the PO can take an answer back.
SWITCHBOARD_UNDO_WINDOW=10s

# How long a session may say nothing before the table marks its row as quiet.
# It marks silence, not death: the service cannot tell a long task from a dead
# session, and does not pretend to.
SWITCHBOARD_QUIET_AFTER=30m

# How long what somebody saw of a session is still worth showing on its row.
# An observation says something about now; past this the service stops sending
# it rather than let a reader date an old reading themselves.
SWITCHBOARD_OBSERVATION_VALID_FOR=10m
