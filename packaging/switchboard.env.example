# switchboard settings. Edit, then: systemctl --user restart switchboard
# This file is never overwritten by an install or an upgrade.

# Where the service listens. The PO's page is served here.
SWITCHBOARD_ADDR=127.0.0.1:8787

# Optional. Only needed if sessions send bare issue numbers (--issue 142); it
# says which repository those belong to. Sessions that send the full address
# (--issue https://github.com/acme/app/issues/142) need nothing here.
SWITCHBOARD_REPO=

# Grouping of the manager's wake-up signal.
SWITCHBOARD_DEBOUNCE=3m
SWITCHBOARD_MIN_INTERVAL=5m
SWITCHBOARD_URGENT=30s

# How long the PO can take an answer back.
SWITCHBOARD_UNDO_WINDOW=10s
